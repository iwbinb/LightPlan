    "opportunity.lowNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within 3° horizontally; body altitude 0–15°. Geometric match only; no terrain or weather check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水平方位误差≤3°，天体高度0–15°。仅判断几何匹配，不判断地形或天气。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "水平方位誤差≤3°，天體高度0–15°。僅判斷幾何匹配，不判斷地形或天氣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水平方位の誤差3°以内、天体高度0〜15°。地形や天候は考慮しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수평 오차 3° 이내, 천체 고도 0–15°. 지형과 날씨는 반영하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontaler Fehler ≤3°, Höhe 0–15°. Rein geometrisch, ohne Gelände- oder Wetterprüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écart horizontal ≤3°, hauteur 0–15°. Correspondance géométrique, sans relief ni météo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลาดเคลื่อนแนวราบไม่เกิน 3° มุมเงย 0–15° คำนวณเรขาคณิตเท่านั้น ไม่รวมภูมิประเทศหรืออากาศ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro horizontal ≤3°, altitude 0–15°. Apenas geometria, sem terreno ou meteorologia."
          }
        }
      }
    },
    "opportunity.twilightNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within 3°; body altitude 0–30° and Sun altitude −6–6°. This describes angles, not guaranteed light quality."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方位误差≤3°，天体高度0–30°，太阳高度−6–6°。这是角度条件，不保证实际光线质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方位誤差≤3°，天體高度0–30°，太陽高度−6–6°。這是角度條件，不保證實際光線品質。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誤差3°以内、天体高度0〜30°、太陽高度−6〜6°。角度条件であり、実際の光を保証しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오차 3° 이내, 천체 고도 0–30°, 태양 고도 −6–6°. 실제 빛의 품질을 보장하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler ≤3°, Höhe 0–30°, Sonnenhöhe −6–6°. Winkelbedingungen, keine Garantie für die Lichtqualität."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écart ≤3°, hauteur 0–30°, Soleil entre −6 et 6°. Ces angles ne garantissent pas la qualité de la lumière."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลาดเคลื่อนไม่เกิน 3° มุมเงย 0–30° ดวงอาทิตย์ −6–6° เป็นเงื่อนไขมุม ไม่รับประกันคุณภาพแสง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro ≤3°, altitude 0–30° e Sol entre −6 e 6°. Estes ângulos não garantem a qualidade da luz."
          }
        }
      }
    },
    "opportunity.allNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closest daily candidates above −1°, including weak matches. Compare the error and altitude before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示每天高度≥−1°的最近候选，包括偏差较大的结果。保存前请核对误差和高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示每天高度≥−1°的最近候選，包括偏差較大的結果。儲存前請核對誤差和高度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度−1°以上で日ごとに最も近い候補。誤差の大きい結果も含みます。保存前に誤差と高度をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고도 −1° 이상인 일별 최적 후보이며 오차가 큰 결과도 포함됩니다. 저장 전 오차와 고도를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Täglich nächster Kandidat über −1°, auch mit großen Abweichungen. Prüfen Sie Fehler und Höhe vor dem Speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleur candidat quotidien au-dessus de −1°, même avec un écart important. Vérifiez l’écart et la hauteur avant d’enregistrer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงตัวเลือกที่ใกล้ที่สุดแต่ละวันที่สูงกว่า −1° รวมผลที่คลาดเคลื่อนมาก ตรวจสอบมุมก่อนบันทึก"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidato diário mais próximo acima de −1°, incluindo correspondências fracas. Verifique o erro e a altitude antes de guardar."
          }
        }
      }
    },
    "opportunity.noMatch": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time meets these conditions in the next 14 days. Try another position, subject or condition. All candidates can show near misses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来14天没有满足条件的时刻。请调整机位、主体或条件；“全部候选”可查看最接近的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未來14天沒有滿足條件的時刻。請調整機位、主體或條件；「全部候選」可查看最接近的結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後14日間に条件を満たす時刻はありません。地点、被写体、条件を変更するか「全候補」で近い結果を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 14일 동안 조건에 맞는 시간이 없습니다. 위치, 피사체 또는 조건을 바꾸거나 모든 후보에서 가까운 결과를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den nächsten 14 Tagen passt keine Zeit. Ändern Sie Standort, Motiv oder Bedingungen. Alle Kandidaten zeigt die nächsten Treffer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun horaire ne correspond sur 14 jours. Changez de position, de sujet ou de critères. Tous les candidats affiche les résultats les plus proches."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเวลาที่ตรงเงื่อนไขใน 14 วันข้างหน้า ลองเปลี่ยนตำแหน่ง วัตถุ หรือเงื่อนไข เลือกทั้งหมดเพื่อดูผลที่ใกล้เคียง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma hora cumpre as condições nos próximos 14 dias. Altere o local, motivo ou condições. Todos mostra os resultados mais próximos."
          }
        }
      }
    },
