    "backup.recoveryWarning": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved file could not be read. It has not been overwritten. Export it before importing a valid backup; recovery also keeps a copy of the original file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取存档，原文件未被覆盖。建议先导出原文件，再导入有效备份；恢复时也会保留原文件副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取存檔，原檔案未被覆蓋。建議先匯出原檔案，再匯入有效備份；復原時也會保留原檔案副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存ファイルを読み取れませんでした。上書きはしていません。有効なバックアップを読み込む前に、このファイルを書き出してください。復元時にも元のファイルのコピーを残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 파일을 읽을 수 없습니다. 원본 파일은 덮어쓰지 않았습니다. 유효한 백업을 가져오기 전에 원본을 내보내세요. 복구할 때도 원본 사본을 보관합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Datei konnte nicht gelesen werden und wurde nicht überschrieben. Exportieren Sie sie vor dem Import einer gültigen Sicherung. Auch bei der Wiederherstellung bleibt eine Kopie der ursprünglichen Datei erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier enregistré n’a pas pu être lu et n’a pas été écrasé. Exportez-le avant d’importer une sauvegarde valide. La récupération conserve également une copie du fichier original."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านไฟล์ที่บันทึกไว้ได้ และยังไม่ได้เขียนทับไฟล์เดิม โปรดส่งออกไฟล์ก่อนนำเข้าข้อมูลสำรองที่ถูกต้อง การกู้คืนจะเก็บสำเนาไฟล์เดิมไว้ด้วย"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o ficheiro guardado. Não foi substituído. Exporte-o antes de importar uma cópia de segurança válida. A recuperação também preserva uma cópia do ficheiro original."
          }
        }
      }
    },
