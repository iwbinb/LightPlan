        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ใต้ขอบฟ้าเชิงเรขาคณิต เส้นประแสดงทิศทางเท่านั้น"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo do horizonte geométrico. A linha tracejada indica apenas a direção."
          }
        }
      }
    },
    "map.directionNote": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines point from the camera location toward the sun or moon. They do not model building shadows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "射线从拍摄点指向太阳或月亮，不代表建筑物的真实阴影。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "射線從拍攝點指向太陽或月亮，不代表建築物的真實陰影。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線は撮影地点から太陽や月への方向です。建物の実際の影は計算しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선은 촬영 위치에서 태양이나 달을 향합니다. 건물의 실제 그림자는 계산하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linien zeigen vom Kamerastandort zur Sonne oder zum Mond. Gebäudeschatten werden nicht berechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes vont du point de prise de vue vers le soleil ou la lune. Elles ne modélisent pas les ombres des bâtiments."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นชี้จากจุดถ่ายภาพไปยังดวงอาทิตย์หรือดวงจันทร์ ไม่ใช่แบบจำลองเงาอาคาร"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas apontam do local da câmara para o sol ou a lua. Não representam sombras de edifícios."
          }
        }
      }
    },
    "map.accessibility": {
      "extractionState": "manual",
