          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde LightPlan n’est pas prise en charge ou dépasse 5 Mo. Vos données existantes n’ont pas été modifiées."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ไม่ใช่ข้อมูลสำรอง LightPlan ที่รองรับ หรือมีขนาดเกิน 5 MB ข้อมูลเดิมของคุณไม่ได้เปลี่ยนแปลง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia de segurança do LightPlan não é compatível ou excede 5 MB. Os dados existentes não foram alterados."
          }
        }
      }
    },
