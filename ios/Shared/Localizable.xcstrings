        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane mit dem Licht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez avec la lumière."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางแผนตามแสง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeie com a luz."
          }
        }
      }
    },
    "onboarding.body": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a place and date. Explore the sun’s direction and save your shoot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择地点和日期，查看太阳方向，保存拍摄计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇地點和日期，查看太陽方向，儲存拍攝計劃。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所と日付を選び、太陽の方向を確認して撮影プランを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소와 날짜를 선택하고 태양의 방향을 확인한 뒤 촬영 계획을 저장하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Ort und Datum, prüfe den Sonnenstand und speichere deinen Fotoplan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un lieu et une date, explorez la direction du soleil et enregistrez votre séance."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสถานที่และวันที่ ดูทิศทางดวงอาทิตย์ แล้วบันทึกแผนถ่ายภาพ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um local e uma data, veja a direção do sol e guarde o seu plano."
          }
        }
      }
    },
    "onboarding.offline": {
