        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태양 고도로 계산하며 실제 빛은 날씨에 따라 달라집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Sonnenhöhe berechnet; das Wetter beeinflusst das Licht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé selon la hauteur du Soleil ; la météo influe sur la lumière."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณจากมุมเงยดวงอาทิตย์ แสงจริงขึ้นอยู่กับสภาพอากาศ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado pela altura solar; o tempo influencia a luz."
          }
        }
      }
    },
