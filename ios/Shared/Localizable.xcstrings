    "frame.referenceHint": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The crosshair represents the chosen point on your subject. Enter its angle above the horizon; 0° assumes a level reference, not a measured height."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "十字准线代表主体上选定的参考点。请输入其相对水平面的仰角；0° 仅假设参考点水平，不代表测得的高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "十字準線代表主體上選定的參考點。請輸入其相對水平面的仰角；0° 僅假設參考點水平，不代表測得的高度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十字線は被写体上の基準点です。水平面からの仰角を入力してください。0°は水平と仮定する値で、測定した高さではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "십자선은 피사체에서 선택한 기준점입니다. 수평면 위의 각도를 입력하세요. 0°는 수평을 가정한 값이며 측정된 높이가 아닙니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fadenkreuz zeigt den gewählten Motivpunkt. Geben Sie seinen Winkel über der Horizontalen ein. 0° setzt eine waagerechte Referenz voraus, keine gemessene Höhe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réticule représente le point choisi sur votre sujet. Saisissez son angle au-dessus de l’horizontale ; 0° suppose un repère horizontal, sans mesure de hauteur."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กากบาทแทนจุดที่เลือกบนวัตถุ ป้อนมุมของจุดนั้นเหนือแนวระดับ ค่า 0° สมมติว่าจุดอยู่ในแนวระดับ ไม่ใช่ความสูงที่วัดได้"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mira representa o ponto escolhido no motivo. Introduza o ângulo acima da horizontal; 0° pressupõe uma referência ao nível, não uma altura medida."
          }
        }
      }
    },
    "frame.legend": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crosshair: subject reference · Disc: Sun or Moon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "十字：主体参考点 · 圆盘：太阳或月亮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "十字：主體參考點 · 圓盤：太陽或月亮"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十字：被写体の基準点 · 円盤：太陽または月"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "십자선: 피사체 기준점 · 원반: 태양 또는 달"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fadenkreuz: Motivpunkt · Scheibe: Sonne oder Mond"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réticule : repère du sujet · Disque : Soleil ou Lune"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กากบาท: จุดอ้างอิงบนวัตถุ · วงกลม: ดวงอาทิตย์หรือดวงจันทร์"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira: referência do motivo · Disco: Sol ou Lua"
          }
        }
      }
    },
    "frame.modelNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometric preview, not a camera view. Terrain, subject shape, refraction and lens distortion are not modelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是几何预演，不是相机实景。未计算地形、主体形状、大气折射及镜头畸变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是幾何預演，不是相機實景。未計算地形、主體形狀、大氣折射及鏡頭畸變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幾何学的なプレビューで、カメラの実写映像ではありません。地形、被写体の形、屈折、レンズの歪みは考慮しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기하학적 미리보기이며 실제 카메라 화면이 아닙니다. 지형, 피사체 모양, 굴절, 렌즈 왜곡은 반영하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometrische Vorschau, kein Kamerabild. Gelände, Motivform, Lichtbrechung und Objektivverzeichnung werden nicht berücksichtigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu géométrique, pas une vue de l’appareil photo. Le relief, la forme du sujet, la réfraction et la distorsion ne sont pas modélisés."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นภาพตัวอย่างทางเรขาคณิต ไม่ใช่ภาพจากกล้อง ไม่รวมภูมิประเทศ รูปร่างวัตถุ การหักเหแสง หรือความบิดเบี้ยวของเลนส์"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização geométrica, não uma imagem da câmara. Não inclui terreno, forma do motivo, refração nem distorção da objetiva."
          }
        }
      }
    },
