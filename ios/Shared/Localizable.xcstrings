    "frame.focalHint": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the 35 mm equivalent focal length. This preview uses a 3:2 sensor frame."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 35 mm 等效焦距；本预演按 3:2 画幅计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 35 mm 等效焦距；本預演按 3:2 畫幅計算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "35 mm判換算の焦点距離を使います。このプレビューは3:2の画幅で計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "35 mm 환산 초점 거리를 사용하세요. 이 미리보기는 3:2 센서 비율로 계산합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die kleinbildäquivalente Brennweite. Diese Vorschau rechnet mit einem Sensorformat von 3:2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la focale équivalente en 24 × 36. Cet aperçu utilise un format de capteur 3:2."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ทางยาวโฟกัสเทียบเท่า 35 มม. ภาพตัวอย่างนี้คำนวณจากสัดส่วนเซนเซอร์ 3:2"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a distância focal equivalente a 35 mm. Esta pré-visualização usa um sensor de formato 3:2."
          }
        }
      }
    },
