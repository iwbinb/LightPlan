    "search.empty": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No window matches these conditions in the selected range. Change the dates, conditions or shooting position."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选日期范围内没有符合条件的时段。请调整日期、条件或机位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選日期範圍內沒有符合條件的時段。請調整日期、條件或機位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した期間に条件を満たす時間帯はありません。日付、条件、撮影位置を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기간에 조건을 충족하는 시간대가 없습니다. 날짜, 조건 또는 촬영 위치를 변경하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im gewählten Zeitraum passt kein Zeitfenster. Ändern Sie Datum, Bedingungen oder Standort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun créneau ne correspond sur cette période. Modifiez les dates, les critères ou votre position."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีช่วงเวลาที่ตรงเงื่อนไขในช่วงที่เลือก ลองเปลี่ยนวันที่ เงื่อนไข หรือตำแหน่งถ่ายภาพ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma janela cumpre as condições no período escolhido. Altere as datas, as condições ou a posição."
          }
        }
      }
    },
