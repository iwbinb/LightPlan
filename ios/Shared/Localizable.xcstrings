    "frame.referenceAltitude": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subject reference angle"
          }
        },
