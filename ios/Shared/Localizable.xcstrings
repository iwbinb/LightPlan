    "guide.steps": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a shooting position, mark your subject on the map, then find a time and save your plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择拍摄机位，在地图上标记主体，再寻找时刻并保存计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇拍攝機位，在地圖上標記主體，再尋找時刻並儲存計畫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影地点を選び、地図上で被写体を指定して、時刻を探し計画を保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 위치를 고르고 지도에 피사체를 표시한 다음 시간을 찾아 계획을 저장하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Standort, markieren Sie das Motiv auf der Karte, suchen Sie eine Zeit und speichern Sie den Plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une position, marquez votre sujet sur la carte, puis trouvez un horaire et enregistrez votre plan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตำแหน่งถ่ายภาพ ทำเครื่องหมายวัตถุบนแผนที่ แล้วค้นหาเวลาและบันทึกแผน"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o local, marque o motivo no mapa, encontre uma hora e guarde o plano."
          }
        }
      }
    },
