    "settings.reminderBudget": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LightPlan keeps up to 48 upcoming reminders scheduled. Open the app regularly to schedule later plans. System settings may delay or silence delivery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LightPlan 最多安排 48 条近期提醒。请定期打开 App，以续排更晚的计划。系统设置可能延迟或静音通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LightPlan 最多安排 48 則近期提醒。請定期開啟 App，以續排較晚的計畫。系統設定可能延遲或靜音通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LightPlanは直近の通知を最大48件予約します。後の計画を予約するため、定期的にアプリを開いてください。システム設定により配信が遅れたり、消音されたりする場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LightPlan은 다가오는 알림을 최대 48개 예약합니다. 이후 계획의 알림을 예약하려면 앱을 주기적으로 열어 주세요. 시스템 설정에 따라 알림이 지연되거나 소리가 나지 않을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LightPlan plant bis zu 48 bevorstehende Erinnerungen. Öffnen Sie die App regelmäßig, damit spätere Pläne eingeplant werden. Systemeinstellungen können die Zustellung verzögern oder stummschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LightPlan programme jusqu’à 48 rappels à venir. Ouvrez régulièrement l’app pour programmer les projets plus lointains. Les réglages système peuvent retarder ou rendre silencieuses les notifications."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "LightPlan จะตั้งการแจ้งเตือนที่ใกล้ถึงเวลาสูงสุด 48 รายการ โปรดเปิดแอปเป็นระยะเพื่อตั้งการแจ้งเตือนของแผนถัดไป การตั้งค่าระบบอาจทำให้แจ้งเตือนล่าช้าหรือไม่มีเสียง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O LightPlan agenda até 48 lembretes próximos. Abra a aplicação regularmente para agendar os planos posteriores. As definições do sistema podem atrasar ou silenciar as notificações."
          }
        }
      }
    },
