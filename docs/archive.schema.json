{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LightPlan archive (read v1/v2, write v2)",
  "description": "The app writes schema 2 and reads schema 1 or 2. Native validation additionally enforces IANA timezones, finite numbers, unique IDs, trimmed nonempty names, supported civil years 1900–2100, a 5 MB limit, and composition geometry/date consistency. JSON Schema string length counts Unicode code points; Swift uses extended grapheme clusters.",
  "type": "object",
  "required": [
    "schemaVersion",
    "places",
    "plans"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "places": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "plans": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/plan"
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "place": {
      "type": "object",
      "required": [
        "id",
        "name",
        "coordinate",
        "timeZoneID"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "coordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "timeZoneID": {
          "type": "string",
          "minLength": 1
        },
        "isExample": {
          "type": "boolean"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "id",
        "title",
        "place",
        "date",
        "target",
        "arrivalLeadMinutes",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "target": {
          "enum": [
            "sunrise",
            "sunset",
            "goldenMorning",
            "goldenEvening",
            "blueEvening",
            "composition"
          ]
        },
        "arrivalLeadMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "reminderLeadMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1440
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "composition": {
          "anyOf": [
            {
              "$ref": "#/$defs/composition"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "collectionName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "const": "composition"
              }
            }
          },
          "then": {
            "required": [
              "composition"
            ],
            "properties": {
              "composition": {
                "$ref": "#/$defs/composition"
              }
            }
          },
          "else": {
            "properties": {
              "composition": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "composition": {
      "type": "object",
      "required": [
        "body",
        "subject",
        "desiredOffsetDegrees",
        "instant"
      ],
      "properties": {
        "body": {
          "enum": [
            "sun",
            "moon"
          ]
        },
        "subject": {
          "$ref": "#/$defs/coordinate"
        },
        "desiredOffsetDegrees": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "instant": {
          "type": "string",
          "format": "date-time"
        },
        "constraints": {
          "anyOf": [
            {
              "$ref": "#/$defs/opportunityConstraints"
            },
            {
              "type": "null"
            }
          ]
        },
        "cameraFraming": {
          "anyOf": [
            {
              "$ref": "#/$defs/cameraFraming"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Observer and destination timezone are stored in plan.place. instant must fall in the same destination civil day as plan.date; subject must have a defined bearing from the observer. Native validation enforces these cross-field constraints."
    },
    "cameraFraming": {
      "type": "object",
      "required": [
        "focalLength35mm",
        "orientation",
        "referenceAltitudeDegrees"
      ],
      "properties": {
        "focalLength35mm": {
          "type": "number",
          "minimum": 14,
          "maximum": 1200
        },
        "orientation": {
          "enum": [
            "landscape",
            "portrait"
          ]
        },
        "referenceAltitudeDegrees": {
          "type": "number",
          "minimum": -30,
          "maximum": 60
        }
      },
      "description": "Optional geometric camera snapshot. A 36 by 24 mm equivalent rectilinear sensor, with a user-supplied reference-point altitude. Does not encode measured subject height, terrain, lens calibration, refraction or actual visibility. Missing/null preserves older v2 compositions."
    },
    "altitudeRange": {
      "type": "object",
      "required": [
        "lowerBound",
        "upperBound"
      ],
      "properties": {
        "lowerBound": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "upperBound": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "description": "Bounds are finite geometric center altitudes in degrees. Native decoding additionally requires lowerBound < upperBound; standard JSON Schema does not compare sibling numeric fields."
    },
    "moonIlluminationRange": {
      "type": "object",
      "required": [
        "lowerBound",
        "upperBound"
      ],
      "properties": {
        "lowerBound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upperBound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Illuminated fraction of the Moon, not a percentage or terrain visibility. Native decoding additionally requires lowerBound <= upperBound. A zero-width range has no positive-duration shooting window; standard JSON Schema does not compare sibling numeric fields."
    },
    "opportunityConstraints": {
      "type": "object",
      "required": [
        "maximumErrorDegrees",
        "altitudeRange"
      ],
      "properties": {
        "maximumErrorDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "altitudeRange": {
          "$ref": "#/$defs/altitudeRange"
        },
        "solarAltitudeRange": {
          "anyOf": [
            {
              "$ref": "#/$defs/altitudeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "moonIlluminationRange": {
          "anyOf": [
            {
              "$ref": "#/$defs/moonIlluminationRange"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Optional saved geometric opportunity-search conditions. Missing/null composition.constraints preserves old v2 compatibility; encoding absent conditions omits the key. This is not a weather or terrain visibility forecast."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "plans": {
            "items": {
              "properties": {
                "target": {
                  "not": {
                    "const": "composition"
                  }
                },
                "composition": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    }
  ]
}
