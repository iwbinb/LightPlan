    },
    "flow.discard": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄變更"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を破棄"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항 버리기"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen verwerfen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner les modifications"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิ้งการเปลี่ยนแปลง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar alterações"
          }
        }
      }
    },
    "plan.changedElsewhere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan changed or was removed. Your draft is still here; reopen the plan before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划已被修改或删除。当前草稿仍保留，请重新打开计划后再保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫已被修改或刪除。目前草稿仍保留，請重新開啟計畫後再儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この計画は変更または削除されました。下書きは保持されています。計画を開き直してから保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획이 변경되거나 삭제되었습니다. 초안은 유지됩니다. 계획을 다시 연 후 저장하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Plan wurde geändert oder gelöscht. Ihr Entwurf bleibt erhalten. Öffnen Sie den Plan vor dem Speichern erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce programme a été modifié ou supprimé. Votre brouillon est conservé ; rouvrez le programme avant de l’enregistrer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนนี้ถูกแก้ไขหรือลบแล้ว ฉบับร่างยังคงอยู่ โปรดเปิดแผนอีกครั้งก่อนบันทึก"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plano foi alterado ou eliminado. O rascunho mantém-se; reabra o plano antes de guardar."
          }
        }
      }
    },
    "backup.changedElsewhere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved data changed after this preview. Close it and select the backup again to review the current conflicts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览后本地数据已变化。请关闭预览并重新选择备份，核对最新冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽後本機資料已變更。請關閉預覽並重新選擇備份，核對最新衝突。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー後に保存データが変わりました。閉じてバックアップを選び直し、現在の競合を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 이후 저장된 데이터가 변경되었습니다. 닫은 후 백업을 다시 선택하여 현재 충돌을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Daten haben sich seit der Vorschau geändert. Schließen Sie sie und wählen Sie die Sicherung erneut, um die aktuellen Konflikte zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données enregistrées ont changé depuis cet aperçu. Fermez-le et sélectionnez à nouveau la sauvegarde pour vérifier les conflits actuels."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลที่บันทึกเปลี่ยนไปหลังจากดูตัวอย่าง โปรดปิดแล้วเลือกข้อมูลสำรองอีกครั้งเพื่อตรวจสอบข้อขัดแย้งล่าสุด"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados guardados mudaram desde esta pré-visualização. Feche-a e volte a selecionar a cópia de segurança para rever os conflitos atuais."
          }
        }
      }
    },
    "backup.keepBoth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both (import a copy)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留两份（导入副本）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留兩份（匯入副本）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方を保持（コピーを読み込む）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 유지 (사본 가져오기)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide behalten (Kopie importieren)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les deux (importer une copie)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บทั้งสองรายการ (นำเข้าสำเนา)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter ambos (importar uma cópia)"
          }
        }
      }
    },
    "backup.keepBothNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflicting plans are imported as new copies with reminders off. Existing plans and their reminders stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有冲突的计划将作为新副本导入，并关闭提醒。原有计划及其提醒保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有衝突的計畫將作為新副本匯入，並關閉提醒。原有計畫及其提醒保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合する計画はリマインダーをオフにした新しいコピーとして読み込まれます。既存の計画とリマインダーは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌하는 계획은 알림이 꺼진 새 사본으로 가져옵니다. 기존 계획과 알림은 변경되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pläne mit Konflikten werden als neue Kopien ohne Erinnerungen importiert. Bestehende Pläne und ihre Erinnerungen bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les programmes en conflit sont importés comme nouvelles copies, sans rappel. Les programmes existants et leurs rappels restent inchangés."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนที่ขัดแย้งกันจะถูกนำเข้าเป็นสำเนาใหม่โดยปิดการเตือน แผนเดิมและการเตือนจะไม่เปลี่ยนแปลง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os planos em conflito são importados como novas cópias sem lembretes. Os planos existentes e os respetivos lembretes mantêm-se."
          }
        }
      }
    },
    "backup.importedReminderWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup imported. Some reminders could not be scheduled; review notification settings and each plan’s reminder status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已导入，但部分提醒未能安排。请检查通知设置及各计划的提醒状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份已匯入，但部分提醒未能排程。請檢查通知設定及各計畫的提醒狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを読み込みました。一部のリマインダーを設定できませんでした。通知設定と各計画のリマインダーの状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 가져왔습니다. 일부 알림을 예약하지 못했습니다. 알림 설정과 각 계획의 알림 상태를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherung importiert. Einige Erinnerungen konnten nicht geplant werden. Prüfen Sie die Mitteilungseinstellungen und den Erinnerungsstatus der Pläne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde importée. Certains rappels n’ont pas pu être programmés ; vérifiez les réglages de notification et l’état des rappels de chaque programme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าข้อมูลสำรองแล้ว แต่ตั้งเวลาการเตือนบางรายการไม่ได้ โปรดตรวจสอบการตั้งค่าการแจ้งเตือนและสถานะการเตือนของแต่ละแผน"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópia de segurança importada. Não foi possível agendar alguns lembretes; reveja as definições de notificações e o estado dos lembretes de cada plano."
          }
        }
      }
    }
  }
}
