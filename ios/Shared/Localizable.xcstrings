    "onboarding.caveat": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps and place search need a connection. Clouds and obstructions can change the light you see."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图和地点搜索需要联网。云层与遮挡会影响现场光线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖和地點搜尋需要連線。雲層與遮擋會影響現場光線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図と場所検索には通信が必要です。雲や障害物により実際の光は変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도와 장소 검색에는 인터넷이 필요합니다. 구름과 장애물에 따라 실제 빛은 달라집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten und Ortssuche benötigen Internet. Wolken und Hindernisse verändern das sichtbare Licht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes et la recherche de lieux nécessitent internet. Les nuages et les obstacles modifient la lumière observée."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนที่และการค้นหาสถานที่ต้องใช้อินเทอร์เน็ต เมฆและสิ่งกีดขวางอาจเปลี่ยนแสงที่เห็น"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mapas e a pesquisa precisam de internet. Nuvens e obstáculos podem alterar a luz observada."
          }
        }
      }
    },
