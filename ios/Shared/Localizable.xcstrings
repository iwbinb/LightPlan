    "settings.privacySummary": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No advertising SDK or account. Map and location requests use Apple services. Exported backups contain your chosen places."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无广告SDK，无账号。地图和定位请求使用Apple服务。导出的备份包含所选地点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無廣告SDK，無帳號。地圖和定位請求使用Apple服務。匯出的備份包含所選地點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告SDKとアカウントはありません。地図・位置情報にはAppleのサービスを利用します。バックアップには選択した場所が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 SDK와 계정이 없습니다. 지도와 위치 요청에는 Apple 서비스를 사용합니다. 백업에는 선택한 장소가 포함됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Werbe-SDK und kein Konto. Karten- und Standortanfragen nutzen Apple-Dienste. Sicherungen enthalten deine gewählten Orte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans SDK publicitaire ni compte. Les cartes et la localisation utilisent les services Apple. Les sauvegardes contiennent les lieux choisis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มี SDK โฆษณาหรือบัญชี การเรียกใช้แผนที่และตำแหน่งใช้บริการ Apple ไฟล์สำรองมีสถานที่ที่คุณเลือก"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem SDK publicitário nem conta. Mapas e localização usam serviços Apple. As cópias incluem os locais escolhidos."
          }
        }
      }
    },
