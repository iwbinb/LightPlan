        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計劃已儲存，已安排的提醒過多。請移除舊提醒後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。通知が多すぎます。古い通知を削除して再試行してください。"
