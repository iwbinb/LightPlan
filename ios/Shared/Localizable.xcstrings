    "horizon.alwaysAbove": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays above the nominal rise/set horizon on this date."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天太阳持续高于设定的日出日落地平线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一天太陽持續高於設定的日出日落地平線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日は太陽が日の出・日の入りの基準線より上に留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜에는 태양이 기준 일출·일몰 지평선 위에 머뭅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne bleibt an diesem Datum über dem rechnerischen Auf- und Untergangshorizont."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette date, le soleil reste au-dessus de l’horizon de lever et coucher retenu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในวันนี้ดวงอาทิตย์อยู่เหนือขอบฟ้ามาตรฐานสำหรับเวลาขึ้นและตกตลอดวัน"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta data, o sol permanece acima do horizonte usado para o nascer e o pôr do sol."
          }
        }
      }
    },
    "horizon.alwaysBelow": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays below the nominal rise/set horizon. Twilight may still occur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天太阳持续低于设定的日出日落地平线，但仍可能有曙暮光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一天太陽持續低於設定的日出日落地平線，但仍可能有曙暮光。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日は太陽が基準線より下に留まりますが、薄明が生じる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜에는 태양이 기준 지평선 아래에 머물지만 박명은 발생할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne bleibt unter dem rechnerischen Horizont. Dämmerung ist dennoch möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soleil reste sous l’horizon retenu. Des périodes de crépuscule restent possibles."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดวงอาทิตย์อยู่ใต้ขอบฟ้ามาตรฐานตลอดวัน แต่อาจยังมีแสงสนธยา"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol permanece abaixo do horizonte de referência. Ainda pode haver crepúsculo."
          }
        }
      }
    },
