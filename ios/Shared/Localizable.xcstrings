    "place.networkNote": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search requires internet. Saved coordinates and their sun and moon calculations remain available offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索需要联网。已保存地点的坐标与日月计算可以离线使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋需要連線。已儲存地點的座標與日月計算可以離線使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索には通信が必要です。保存した座標と太陽・月の計算はオフラインでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색에는 인터넷이 필요합니다. 저장된 좌표와 태양·달 계산은 오프라인에서도 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche benötigt Internet. Gespeicherte Koordinaten sowie Sonnen- und Mondberechnungen bleiben offline verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche nécessite internet. Les coordonnées enregistrées et les calculs restent disponibles hors ligne."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาต้องใช้อินเทอร์เน็ต พิกัดที่บันทึกและการคำนวณดวงอาทิตย์กับดวงจันทร์ยังใช้แบบออฟไลน์ได้"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa precisa de internet. As coordenadas guardadas e os cálculos continuam disponíveis offline."
          }
        }
      }
    },
