    "backup.explanation": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you confirm. Existing items are matched by their saved identifiers. New reminders remain off unless you enable them here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认前不会修改数据。已有项目按保存的标识匹配。导入的新增提醒默认关闭，可在此主动开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認前不會修改資料。已有項目依儲存的識別碼比對。匯入的新增提醒預設關閉，可在此主動開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するまでデータは変更されません。保存された識別子で既存の項目を照合します。新たに読み込む通知は、ここで有効にしない限りオフのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하기 전에는 데이터가 변경되지 않습니다. 저장된 식별자로 기존 항목을 비교합니다. 새로 가져온 알림은 여기에서 활성화하지 않으면 꺼진 상태로 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst nach Ihrer Bestätigung werden Daten geändert. Vorhandene Einträge werden anhand ihrer gespeicherten Kennungen zugeordnet. Neue Erinnerungen bleiben deaktiviert, sofern Sie sie hier nicht aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée ne change avant votre confirmation. Les éléments existants sont associés à leurs identifiants enregistrés. Les nouveaux rappels restent désactivés, sauf si vous les activez ici."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลจะไม่เปลี่ยนจนกว่าจะยืนยัน ระบบจะจับคู่รายการเดิมด้วยรหัสที่บันทึกไว้ การแจ้งเตือนใหม่ที่นำเข้าจะปิดอยู่จนกว่าคุณจะเปิดที่นี่"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados só mudam após a sua confirmação. Os itens existentes são associados pelos identificadores guardados. Os novos lembretes ficam desativados, a menos que os ative aqui."
          }
        }
      }
    },
