    "plan.arrivalNote": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrival is the target time minus your preparation time. Travel time is not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到场时间为目标时刻减去你设置的准备时间，不包含路程耗时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到場時間為目標時刻減去你設定的準備時間，不包含路程耗時。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着予定は目標時刻から設定した準備時間を引いた時刻です。移動時間は含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착 시간은 목표 시간에서 준비 시간을 뺀 값이며 이동 시간은 포함하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ankunft entspricht dem Zielzeitpunkt abzüglich deiner Vorbereitungszeit. Fahrtzeit ist nicht enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrivée correspond à l’heure cible moins votre préparation. Le trajet n’est pas inclus."
