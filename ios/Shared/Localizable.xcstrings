    "search.allNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All periods above −1°. Weak matches are included; compare the best alignment error."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示天体高度高于 −1° 的所有时段，包含偏差较大的结果，请比较最佳对齐误差。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示天體高度高於 −1° 的所有時段，包含偏差較大的結果，請比較最佳對齊誤差。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度−1°以上の全時間帯。誤差の大きい結果も含みます。最適時刻の誤差を比較してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고도 −1° 이상인 모든 시간대입니다. 오차가 큰 결과도 포함되므로 최적 정렬 오차를 비교하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zeiträume über −1°, auch mit großen Abweichungen. Vergleichen Sie den kleinsten Ausrichtungsfehler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les périodes au-dessus de −1°, même avec un écart important. Comparez l’erreur du meilleur alignement."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกช่วงเวลาที่สูงกว่า −1° รวมผลที่คลาดเคลื่อนมาก โปรดเปรียบเทียบค่าความคลาดเคลื่อนที่ดีที่สุด"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os períodos acima de −1°, incluindo correspondências fracas. Compare o erro do melhor alinhamento."
          }
        }
      }
    },
    "search.geometryNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometric estimates only. Terrain, buildings, weather and access are not evaluated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为几何估算，未评估地形、建筑、天气或通行条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅為幾何估算，未評估地形、建築、天氣或通行條件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幾何学的な推定のみです。地形、建物、天候、立ち入り可否は評価しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기하학적 추정치입니다. 지형, 건물, 날씨와 접근 가능 여부는 평가하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur geometrische Schätzungen. Gelände, Gebäude, Wetter und Zugang werden nicht bewertet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimations géométriques uniquement. Le relief, les bâtiments, la météo et l’accès ne sont pas évalués."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นการประมาณทางเรขาคณิตเท่านั้น ไม่ประเมินภูมิประเทศ อาคาร อากาศ หรือการเข้าถึง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas estimativas geométricas. Não avalia terreno, edifícios, meteorologia nem acesso."
          }
        }
      }
    },
    "search.invalid": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid range; the minimum must be below the maximum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效范围，下限必须低于上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入有效範圍，下限必須低於上限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な範囲を入力してください。最小値は最大値より小さくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 범위를 입력하세요. 최솟값은 최댓값보다 작아야 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen gültigen Bereich ein. Das Minimum muss unter dem Maximum liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une plage valide ; le minimum doit être inférieur au maximum."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนช่วงที่ถูกต้อง ค่าต่ำสุดต้องน้อยกว่าค่าสูงสุด"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um intervalo válido; o mínimo tem de ser inferior ao máximo."
          }
        }
      }
    },
    "search.windowEdgeNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window boundaries are approximate; allow extra time on location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时段边界为估算值，请为现场拍摄预留额外时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時段邊界為估算值，請為現場拍攝預留額外時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯の境界は概算です。現地では時間に余裕を持ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간대의 시작과 끝은 근사값입니다. 현장에서 여유 시간을 확보하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitgrenzen sind Näherungen. Planen Sie vor Ort zusätzliche Zeit ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites des créneaux sont approximatives ; prévoyez une marge sur place."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบเขตช่วงเวลาเป็นค่าประมาณ โปรดเผื่อเวลาเพิ่มเติม ณ สถานที่จริง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites da janela são aproximados; reserve tempo extra no local."
          }
        }
      }
    },
