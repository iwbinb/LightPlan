    "search.truncated": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the 60 closest matches. Narrow the date range to see other windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示最接近的 60 个结果。缩小日期范围可查看其他时段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前顯示最接近的 60 個結果。縮小日期範圍可查看其他時段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近い順に60件を表示しています。他の時間帯を見るには期間を絞ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 가까운 결과 60개를 표시합니다. 다른 시간대를 보려면 날짜 범위를 줄이세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 60 besten Treffer werden angezeigt. Grenzen Sie den Zeitraum ein, um weitere Zeitfenster zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 60 meilleures correspondances sont affichées. Réduisez la période pour voir d’autres créneaux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง 60 ผลลัพธ์ที่ใกล้เคียงที่สุด ลดช่วงวันที่เพื่อดูช่วงเวลาอื่น"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São mostradas as 60 melhores correspondências. Reduza o período para ver outras janelas."
          }
        }
      }
    },
