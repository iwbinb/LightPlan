    "onboarding.title": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan around the light."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为好光线，提前安排。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為好光線，提前安排。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光に合わせて、撮影を計画。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛에 맞춰 촬영을 계획하세요."
