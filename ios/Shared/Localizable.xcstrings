    "notice.notificationCapacity": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan saved. Too many reminders are scheduled. Remove an older reminder and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划已保存，已安排的提醒过多。请移除旧提醒后重试。"
