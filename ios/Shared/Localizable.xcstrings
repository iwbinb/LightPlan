    "v3.plan.goldenHint": {
      "extractionState": "manual",
      "comment": "LightPlan v3 translation draft. Native-language and screenshot review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated from solar altitude; weather affects the light."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按太阳高度角计算，实际光线受天气影响。"
