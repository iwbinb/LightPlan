    "place.manualNote": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use WGS84 coordinates and the destination’s named time zone. The app does not guess a time zone from longitude."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用WGS84坐标，并填写目的地的命名时区。不会按经度猜测时区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用WGS84座標，並填寫目的地的命名時區。不會按經度猜測時區。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WGS84座標と目的地のタイムゾーン名を入力してください。経度からタイムゾーンを推測することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WGS84 좌표와 목적지의 시간대 이름을 입력하세요. 경도로 시간대를 추정하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze WGS84-Koordinaten und die benannte Zeitzone des Ziels. Die Zeitzone wird nicht aus dem Längengrad geschätzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des coordonnées WGS84 et le fuseau nommé du lieu. Le fuseau n’est pas déduit de la longitude."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้พิกัด WGS84 และชื่อเขตเวลาของปลายทาง แอปจะไม่เดาเขตเวลาจากลองจิจูด"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use coordenadas WGS84 e o fuso horário do destino. O fuso não é deduzido da longitude."
          }
        }
      }
    },
