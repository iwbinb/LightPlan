    "notice.reminderSaved": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan saved and reminder scheduled. Delivery depends on system notification settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划已保存，提醒已安排。实际送达受系统通知设置影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計劃已儲存，提醒已安排。實際送達受系統通知設定影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存し、通知を設定しました。通知の配信はシステム設定に左右されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획을 저장하고 알림을 예약했습니다. 실제 전달은 시스템 알림 설정에 따라 달라집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan gespeichert und Erinnerung geplant. Die Zustellung hängt von den Systemeinstellungen ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projet enregistré et rappel programmé. La réception dépend des réglages système."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแผนและตั้งการเตือนแล้ว การแจ้งเตือนขึ้นอยู่กับการตั้งค่าระบบ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Plano guardado e lembrete agendado. A entrega depende das definições do sistema."
          }
        }
      }
    },
    "notice.notificationDenied": {
