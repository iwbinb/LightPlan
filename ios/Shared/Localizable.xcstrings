    "composition.geometryNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map alignment uses azimuth. The framing preview uses your reference-point altitude angle. Actual subject dimensions, terrain, obstructions, roads and on-site safety are not evaluated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图对齐基于方位；构图预演采用你输入的参考点仰角。未计算主体实际尺寸、地形、遮挡、道路或现场安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖對齊基於方位；構圖預演採用你輸入的參考點仰角。未計算主體實際尺寸、地形、遮擋、道路或現場安全。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図上の位置合わせは方位角に基づき、構図プレビューは入力した基準点の仰角を使います。被写体の実寸、地形、遮蔽物、道路、現地の安全性は評価しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 정렬은 방위각을 기준으로 합니다. 구도 미리보기는 입력한 기준점의 고도각을 사용합니다. 피사체의 실제 크기, 지형, 장애물, 도로와 현장 안전은 평가하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kartenausrichtung nutzt den Azimut. Die Bildvorschau nutzt den eingegebenen Höhenwinkel des Motivpunkts. Tatsächliche Motivgröße, Gelände, Hindernisse, Straßen und Sicherheit vor Ort werden nicht bewertet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alignement sur la carte utilise l’azimut. L’aperçu utilise l’angle de hauteur du point de référence saisi. Les dimensions réelles du sujet, le relief, les obstacles, les routes et la sécurité sur place ne sont pas évalués."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจัดแนวบนแผนที่ใช้มุมทิศ ภาพตัวอย่างใช้มุมเงยของจุดอ้างอิงที่คุณป้อน ไม่ประเมินขนาดจริงของวัตถุ ภูมิประเทศ สิ่งกีดขวาง ถนน หรือความปลอดภัยในพื้นที่"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O alinhamento no mapa usa o azimute. A pré-visualização usa o ângulo de elevação do ponto de referência introduzido. Não avalia as dimensões reais do motivo, o terreno, obstáculos, estradas nem a segurança no local."
          }
        }
      }
    },
    "composition.tapTarget": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
