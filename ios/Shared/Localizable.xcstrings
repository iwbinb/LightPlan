    "flow.unsavedBody": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your edits are kept while you continue editing. Discarding does not change a saved plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑会保留当前输入；放弃更改不会修改已有计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續編輯會保留目前輸入；放棄變更不會修改既有計畫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集を続けると入力内容が保持されます。破棄しても保存済みの計画は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 편집하면 입력 내용이 유지됩니다. 버려도 저장된 계획은 변경되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Weiterbearbeiten bleiben Ihre Eingaben erhalten. Verwerfen ändert keinen gespeicherten Plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos saisies sont conservées si vous continuez. Abandonner ne modifie pas le plan enregistré."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากแก้ไขต่อ ข้อมูลที่ป้อนไว้จะยังอยู่ การทิ้งจะไม่เปลี่ยนแผนที่บันทึกไว้"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As entradas mantêm-se enquanto continua a editar. Descartar não altera um plano guardado."
          }
        }
      }
    },
