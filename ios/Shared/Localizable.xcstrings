    "error.archive": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved data could not be read. Writes are paused to protect the original file. Do not delete or overwrite it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取存档，已暂停写入以保护原文件。请勿删除或覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取存檔，已暫停寫入以保護原檔案。請勿刪除或覆寫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存データを読み込めません。元のファイルを保護するため書き込みを停止しました。削除や上書きをしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 데이터를 읽을 수 없습니다. 원본 보호를 위해 쓰기를 중지했습니다. 삭제하거나 덮어쓰지 마세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Daten konnten nicht gelesen werden. Schreibzugriffe sind zum Schutz der Originaldatei angehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données n’ont pas pu être lues. L’écriture est suspendue pour protéger le fichier d’origine. Ne le supprimez pas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อมูลที่บันทึกไม่ได้ จึงหยุดการเขียนเพื่อปกป้องไฟล์ต้นฉบับ โปรดอย่าลบหรือเขียนทับ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
