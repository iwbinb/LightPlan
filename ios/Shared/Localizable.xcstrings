    "composition.recalculateNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the date, celestial body or offset recalculates the alignment time. The observer and subject stay fixed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改日期、天体或偏移会重新计算对齐时刻，观察点和主体保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改日期、天體或偏移會重新計算對齊時刻，觀察點和主體保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付、天体、ずれを変更すると位置合わせ時刻を再計算します。撮影位置と被写体は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜, 천체 또는 각도 차이를 변경하면 정렬 시간을 다시 계산합니다. 관측 위치와 피사체는 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Änderung von Datum, Himmelskörper oder Versatz wird die Ausrichtungszeit neu berechnet. Standort und Motiv bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier la date, l’astre ou le décalage recalcule l’heure d’alignement. Le point d’observation et le sujet restent fixes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนวันที่ วัตถุท้องฟ้า หรือมุมเยื้องจะคำนวณเวลาจัดแนวใหม่ โดยจุดสังเกตและตัวแบบยังคงเดิม"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a data, o astro ou o desvio recalcula a hora de alinhamento. O observador e o motivo mantêm-se fixos."
          }
        }
      }
    },
