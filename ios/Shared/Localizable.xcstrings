    "disclaimer.geometry": {
      "extractionState": "manual",
      "comment": "LightPlan V1 translation draft; native-language and layout review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times and directions are astronomical estimates for an unobstructed horizon. They do not predict cloud cover, terrain, buildings or photographic results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间和方向为无遮挡地平线下的天文估算，不预测云层、地形、建筑遮挡或成片效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間和方向為無遮擋地平線下的天文估算，不預測雲層、地形、建築遮擋或成片效果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻と方向は遮るもののない地平線を前提とした天文計算です。雲・地形・建物や写真の仕上がりは予測しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간과 방향은 장애물이 없는 지평선을 기준으로 한 천문 추정치입니다. 구름, 지형, 건물 또는 사진 결과는 예측하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten und Richtungen sind astronomische Schätzungen für einen freien Horizont. Wolken, Gelände, Gebäude und Fotoergebnisse werden nicht vorhergesagt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures et directions sont des estimations pour un horizon dégagé. Elles ne prédisent ni nuages, ni relief, ni bâtiments, ni résultat photo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาและทิศทางเป็นค่าประมาณทางดาราศาสตร์สำหรับขอบฟ้าที่ไม่มีสิ่งกีดขวาง ไม่ได้ทำนายเมฆ ภูมิประเทศ อาคาร หรือผลลัพธ์ภาพถ่าย"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas e direções são estimativas para um horizonte livre. Não preveem nuvens, relevo, edifícios ou resultados fotográficos."
          }
        }
      }
    },
