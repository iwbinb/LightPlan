    "brief.shareNote": {
      "extractionState": "manual",
      "comment": "Product localization. Language review is tracked separately in the release checklist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing includes exact coordinates and your notes. Check access and conditions before travelling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享包含精确坐标和笔记。出发前请确认路线可达及现场条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享包含精確座標和筆記。出發前請確認路線可達及現場條件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有内容には正確な座標とメモが含まれます。出発前に経路と現地の状況をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 내용에는 정확한 좌표와 메모가 포함됩니다. 출발 전에 접근 경로와 현장 상황을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Teilen werden genaue Koordinaten und Notizen weitergegeben. Prüfen Sie Zugang und Bedingungen vor der Anreise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage inclut les coordonnées précises et vos notes. Vérifiez l’accès et les conditions avant de partir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลที่แชร์มีพิกัดที่แม่นยำและบันทึกของคุณ ตรวจสอบการเข้าถึงและสภาพพื้นที่ก่อนเดินทาง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A partilha inclui coordenadas exatas e notas. Verifique o acesso e as condições antes de partir."
          }
        }
      }
    },
