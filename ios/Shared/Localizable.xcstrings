      "extractionState": "manual",
      "comment": "LightPlan v3 translation draft. Native-language and screenshot review required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native app uses MapKit imagery. This offline reference demonstrates the controls and computed bearings only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生使用MapKit影像；本离线参考只展示控制层与计算方位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生使用MapKit影像；本離線參考只展示控制層與計算方位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実機版はMapKitの画像を使用。このオフライン見本は操作部と計算した方位のみを示します。"
          }
